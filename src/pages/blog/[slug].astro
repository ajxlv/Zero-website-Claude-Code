---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import BlogCard from '../../components/BlogCard.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const all = (await getCollection('blog')).sort((a, b) => a.data.order - b.data.order);
// "Keep reading": three other posts (illustrative selection until real posts exist)
const related = all.filter((p) => p.id !== post.id && !p.data.featured).slice(0, 3);
const d = post.data;
---
<Layout title={`${d.title} | ZERO`} description={d.excerpt} active="Blog">
  <div class="progress" aria-hidden="true"><div data-progress></div></div>
  <header class="head">
    <a href="/blog" class="back">← All posts</a>
    <span style="display:flex;gap:10px;font-size:14px;flex-wrap:wrap"><span class="pill pill-sage" style="padding:5px 12px">{d.category}</span><span style="color:var(--ink2);padding:5px 0">{d.readTime} read · {d.date ?? '[ADD date]'}</span></span>
    <h1 class="h-xl" style="font-size:clamp(40px,4.6vw,62px);line-height:1.02">{d.title}</h1>
    {d.excerpt && <p class="ex">{d.excerpt}</p>}
    <div class="by"><img src="/images/photo-founder-karan.webp" alt="" width="48" height="48" /><span style="display:flex;flex-direction:column"><strong style="font-size:15px">{d.author ?? '[ADD author]'}</strong><span style="font-size:14px;color:var(--ink2)">{d.author === 'Karan Racca' ? 'Founder, ZERO' : ''}</span></span></div>
  </header>
  <div class="coverwrap"><div class="cover">{d.cover ? <img src={d.cover} alt="" /> : <span>Article cover · 2:1</span>}</div></div>

  <article class="prose" data-article>
    <Content />
    <div class="cta"><span class="ct">Get a quick estimate of your own footprint.</span><a href="/free-tools#calculator">Try the free calculator</a></div>
  </article>

  <section class="container more">
    <h2 class="h-lg" style="font-size:36px">Keep reading</h2>
    <div class="grid">{related.map((p) => <BlogCard href={`/blog/${p.id}`} category={p.data.category} readTime={p.data.readTime} title={p.data.title} cover={p.data.cover} />)}</div>
  </section>
</Layout>

<style>
  .progress{position:sticky;top:80px;z-index:40;height:3px}
  .progress div{height:100%;width:0;background:var(--terra);transition:width .1s}
  .head{max-width:880px;margin:0 auto;padding:56px var(--gutter) 40px;display:flex;flex-direction:column;gap:22px}
  .back{align-self:flex-start;font-weight:600;font-size:15px}
  .ex{font-size:21px;line-height:32px;color:var(--ink2);text-wrap:pretty}
  .by{display:flex;align-items:center;gap:14px;padding-top:8px}
  .by img{width:48px;height:48px;border-radius:50%;object-fit:cover}
  .coverwrap{max-width:1120px;margin:0 auto;padding:0 var(--gutter) 56px}
  .cover{aspect-ratio:16/8;border-radius:40px;overflow:hidden;position:relative;background:repeating-linear-gradient(135deg,var(--sage),var(--sage) 14px,var(--sky) 14px,var(--sky) 28px);display:flex;align-items:center;justify-content:center;font-size:13px;color:var(--ink2)}
  .cover img{width:100%;height:100%;object-fit:cover}
  .prose{max-width:720px;margin:0 auto;padding:0 var(--gutter) 96px;display:flex;flex-direction:column;gap:22px;font-size:19px;line-height:32px;color:var(--ink)}
  .prose :global(h2){margin:24px 0 0;font-size:32px;line-height:1.15;letter-spacing:-.02em;color:var(--deep)}
  .prose :global(blockquote){margin:16px 0;padding:8px 0 8px 28px;border-left:3px solid var(--terra);font-family:var(--font-display);font-size:28px;line-height:1.3;font-weight:500;letter-spacing:-.015em;color:var(--deep)}
  .prose :global(blockquote p){margin:0}
  .prose :global(ol),.prose :global(ul){margin:0;padding-left:24px;display:flex;flex-direction:column;gap:10px}
  .prose :global(.sample){background:var(--surface);border:1px solid var(--line);border-radius:32px;padding:28px;display:flex;flex-direction:column;gap:16px;margin:12px 0}
  .prose :global(.sample-t){font-family:var(--font-display);font-weight:600;font-size:18px;color:var(--deep)}
  .prose :global(.sample-bar){display:flex;height:20px;border-radius:999px;overflow:hidden;gap:3px}
  .prose :global(.sample-l){display:flex;gap:20px;flex-wrap:wrap;font-size:15px;line-height:22px;color:var(--ink2)}
  .prose :global(.sample-n){font-size:14px;line-height:21px;color:var(--ink2)}
  .cta{background:var(--night);color:var(--nightInk);border-radius:32px;padding:32px;display:flex;flex-wrap:wrap;gap:20px;justify-content:space-between;align-items:center;margin-top:24px}
  .ct{font-family:var(--font-display);font-size:24px;line-height:1.2;font-weight:600;max-width:360px}
  .cta a{height:52px;padding:0 24px;border-radius:999px;background:var(--leaf);color:var(--night);font-weight:600;font-size:16px;display:flex;align-items:center}
  .cta a:hover{background:#A6D97A;color:var(--night)}
  .more{padding-bottom:120px;display:flex;flex-direction:column;gap:28px}
  .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:24px}
  @media (max-width:700px){ .prose{font-size:17px;line-height:29px} .prose :global(h2){font-size:26px} .prose :global(blockquote){font-size:22px;padding-left:18px} .cover{border-radius:24px} }
</style>

<script>
  // Reading progress: how far the article body has scrolled (0–100%).
  const art = document.querySelector<HTMLElement>('[data-article]');
  const bar = document.querySelector<HTMLElement>('[data-progress]');
  if (art && bar) {
    const f = () => {
      const r = art.getBoundingClientRect();
      const p = Math.min(1, Math.max(0, (window.innerHeight * 0.4 - r.top) / r.height));
      bar.style.width = (p * 100).toFixed(1) + '%';
    };
    f();
    window.addEventListener('scroll', f, { passive: true });
  }
</script>
