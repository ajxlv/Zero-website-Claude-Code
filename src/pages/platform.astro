---
import Layout from '../layouts/Layout.astro';
import CheckList from '../components/CheckList.astro';
import { sbti, project, status } from '../config/sbti';
import { lcaStages } from '../config/lca';

const carbonPts = ['Automated data ingestion from multiple business systems and formats', 'Accurate Scope 1, 2 and 3 emissions calculation with verified factors', 'Compliance-ready reports aligned to global standards (GHG Protocol, ISO 14064 and more)'];
const esgPts = ['Framework-aligned reporting for GRI, SASB, TCFD, CSRD and more', 'Centralised ESG data hub to collect, validate and manage disclosures', 'Automated reporting with audit-ready trails and documentation', 'Performance benchmarking and KPI tracking across ESG pillars'];
const lcaPts = ['Full cradle-to-grave product footprint analysis', 'Database-backed modelling with globally recognised emission datasets', 'Scenario comparison to evaluate design, material and supplier choices', 'LCA output aligned to ISO 14040 / 14044 and EPD-ready'];
const frameworks = ['GRI', 'SASB', 'TCFD', 'CSRD', 'BRSR', 'CDP'];
const aiFeats = [
  { t: 'Long-term strategies', d: 'Personalised reduction strategies based on international standards.' },
  { t: 'Comprehensive reporting', d: 'Accurate, auditable, compliance-ready ESG reporting.' },
  { t: 'Data ingestion', d: 'Eliminates manual uploads and keeps data current.' },
  { t: 'Predictive analytics', d: 'Simulate future emissions based on current trends.' },
];
// [confirm connector list] — open item
const sources = ['ERP', 'Utility bills', 'Fuel & fleet', 'Business travel', 'Procurement', 'HR systems', 'Meters', 'Spreadsheets'];
const initial = project(sbti.defaultRate);
const initStatus = status(sbti.defaultRate);
const max = sbti.baseline;
---
<Layout title="Platform | ZERO" description="Carbon accounting, ESG reporting and product LCA in one platform." active="Platform">
  <section class="container hero">
    <div class="hrow">
      <div class="hl">
        <span class="tag">Our in-house AI-powered platform</span>
        <h1 class="h-display" style="font-size:clamp(46px,5.4vw,76px)">Carbon, ESG and product impact in one <span style="color:var(--terra)">living system.</span></h1>
      </div>
      <div class="hr">
        <p class="lede" style="font-size:19px;line-height:29px">Three modules share one data foundation, so a number entered once shows up correctly in every report.</p>
        <div class="anchors"><a href="#carbon">Carbon Accounting</a><a href="#esg">ESG Reporting</a><a href="#lca">Product LCA</a></div>
      </div>
    </div>
    <div class="stage">
      <div class="browser">
        <div class="chrome"><i></i><i></i><i></i><span>app.zero · Carbon Accounting</span></div>
        <img src="/images/screenshot-dashboard-carbon@2x.webp" alt="ZERO Carbon Accounting dashboard showing yearly footprint, emissions trend and scope split" width="762" height="355" />
      </div>
    </div>
  </section>

  <section id="carbon" class="container two">
    <div class="col">
      <span class="num">01 · Carbon Accounting</span>
      <h2 class="h-lg" style="font-size:clamp(34px,3.6vw,48px)">AI-powered, audit-ready carbon accounting.</h2>
      <p class="body-lg">Built for accuracy, scalability and compliance.</p>
      <CheckList items={carbonPts} size="lg" />
    </div>
    <div class="tiles">
      <div class="tile big">
        <span style="font-size:14px;color:var(--ink2)">Yearly carbon footprint · sample</span>
        <span class="bigv">144.3 <span class="bigu">tCO₂e</span></span>
        <div class="split" role="img" aria-label="Scope 1 20.9%, Scope 2 36.2%, Scope 3 42.9%"><div style="width:20.9%;background:var(--deep)"></div><div style="width:36.2%;background:var(--leaf)"></div><div style="width:42.9%;background:var(--s3)"></div></div>
        <div class="splitl"><span>Scope 1 · 20.9%</span><span>Scope 2 · 36.2%</span><span>Scope 3 · 42.9%</span></div>
      </div>
      <div class="tile dark"><span style="font-size:13px;color:var(--deepInk2)">Data sources</span><span class="tt">ERP, utility bills, fuel, travel, spreadsheets</span></div>
      <div class="tile sage"><span style="font-size:13px;color:var(--deep)">Reports to</span><span class="tt" style="color:var(--deep)">GHG Protocol, ISO 14064</span></div>
    </div>
  </section>

  <section id="esg" class="container esg-wrap">
    <div class="esg">
      <div class="eshot"><img src="/images/screenshot-dashboard-esg@2x.webp" alt="ESG KPI initiatives table with due dates, categories and progress" loading="lazy" /></div>
      <div class="col" style="flex:1 1 380px">
        <span class="num">02 · ESG Reporting</span>
        <h2 class="h-lg" style="font-size:clamp(34px,3.6vw,48px)">Complex requirements, investor-ready reports.</h2>
        <p class="body-lg">Transform ESG requirements into structured, compliant reporting.</p>
        <CheckList items={esgPts} />
        <div class="fw">{frameworks.map((f) => <span>{f}</span>)}</div>
      </div>
    </div>
  </section>

  <section id="lca" class="container two lca">
    <div class="col" style="flex:1 1 400px">
      <span class="num">03 · Product Life Cycle Analysis</span>
      <h2 class="h-lg" style="font-size:clamp(34px,3.6vw,48px)">The whole life of a product, cradle to grave.</h2>
      <p class="body-lg">Scientific, data-backed LCA insights to measure product impact and drive sustainable decisions.</p>
      <CheckList items={lcaPts} />
    </div>
    <div class="lcacard" data-lca>
      <div class="lh"><span style="font-weight:600;color:var(--deep)">Footprint by life-cycle stage</span><span style="font-size:13px;color:var(--ink2)">Illustrative · one tote bag</span></div>
      <div class="stg" role="group" aria-label="Life-cycle stage">
        {lcaStages.map((s, i) => <button type="button" aria-pressed={i === 0 ? 'true' : 'false'} data-i={i}>{s.l}</button>)}
      </div>
      <div class="rows">
        {lcaStages.map((s, i) => (
          <div class="lr" data-row={i} style={i === 0 ? '' : 'opacity:.45'}>
            <span class="ll">{s.l}</span>
            <div class="lbar"><div style={`width:${Math.round((s.v / 1.84) * 100)}%;background:${s.c}`}></div></div>
            <span class="lv">{s.v.toFixed(2)}</span>
          </div>
        ))}
      </div>
      <div class="note"><span data-note style="font-size:15px;line-height:22px;max-width:320px">{lcaStages[0].n}</span><span class="tot">3.27 <span class="totu">kgCO₂e total</span></span></div>
      <script type="application/json" data-json set:html={JSON.stringify(lcaStages.map((s) => s.n))}></script>
    </div>
  </section>

  <section class="ai on-dark">
    <div class="glow" aria-hidden="true"></div>
    <div class="container wide ai-in">
      <div class="aih">
        <div style="display:flex;flex-direction:column;gap:16px;max-width:680px"><span style="font-size:14px;font-weight:600;color:var(--leaf)">AI-powered carbon intelligence</span><h2 class="h-lg" style="color:inherit;font-size:clamp(36px,4vw,54px);line-height:1.03">See where your emissions are heading before you get there.</h2></div>
        <span style="font-size:17px;line-height:26px;color:var(--nightInk2);max-width:380px">Predictive analytics simulates future emissions from current trends. Move the slider to try it.</span>
      </div>
      <div style="display:flex;flex-wrap:wrap;gap:24px">
        <div class="sim" data-sim data-base={sbti.baseline} data-years={sbti.years} data-start={sbti.startYear} data-target={sbti.targetShare}>
          <div class="simtop">
            <label class="rate"><span>Annual reduction rate · <strong data-rate-out>{sbti.defaultRate}%</strong></span><input type="range" min="0" max="15" step="1" value={sbti.defaultRate} /></label>
            <span class:list={['status', initStatus.on ? 'on' : 'off']} data-status role="status">{initStatus.label}</span>
          </div>
          <div class="chart" role="img" aria-label="Projected emissions 2024 to 2030 against the SBTi 2030 target">
            <div class="target" style={`bottom:${(sbti.targetShare * 82).toFixed(1)}%`}><span>SBTi 2030 · −42%</span></div>
            {initial.map((p, i) => (
              <div class="pcol"><span class="pv" data-v>{p.value.toFixed(0)}</span><div class="pbar" data-bar style={`height:${((p.value / max) * 82).toFixed(1)}%;background:${i === 0 ? '#A9C29A' : i === sbti.years - 1 ? '#A6D97A' : 'rgba(120,184,64,.45)'}`}></div></div>
            ))}
          </div>
          <div class="years">{initial.map((p) => <span>{p.year}</span>)}</div>
          <span style="font-size:13px;color:var(--nightInk2)">Baseline 144.3 tCO₂e (2024, sample dashboard). Linear simulation for illustration.</span>
        </div>
        <div class="aif">{aiFeats.map((f) => <div class="af"><span class="aft">{f.t}</span><span class="afd">{f.d}</span></div>)}</div>
      </div>
    </div>
  </section>

  <section class="container ingest">
    <span class="eyebrow">Data ingestion</span>
    <h2 class="h-lg" style="max-width:760px;font-size:clamp(34px,4vw,52px);line-height:1.05">Your systems feed ZERO like roots feed a tree.</h2>
    <p class="body-lg" style="max-width:600px">AI-powered ingestion from multiple business systems and formats keeps sustainability data accurate and up to date, with no manual uploads.</p>
    <div class="srcs">{sources.map((s) => <span>{s}</span>)}</div>
    <span style="font-size:13px;color:var(--ink2)">[confirm connector list]</span>
  </section>

  <section class="cta-wrap">
    <div class="cta">
      <h2 class="h-lg" style="max-width:620px;font-size:clamp(32px,3.6vw,48px);line-height:1.05">See your own data in the platform.</h2>
      <div style="display:flex;gap:12px;flex-wrap:wrap"><a href="/contact" class="btn btn-primary">Book a demo</a><a href="/pricing" class="btn btn-outline">See pricing</a></div>
    </div>
  </section>
</Layout>

<style>
  .tag{align-self:flex-start;background:var(--sage);color:var(--deep);border-radius:999px;padding:8px 16px;font-size:14px;font-weight:600}
  .hero{padding-top:72px;padding-bottom:56px;display:flex;flex-direction:column;gap:48px}
  .hrow{display:flex;flex-wrap:wrap;gap:32px;justify-content:space-between;align-items:end}
  .hl{flex:1 1 560px;display:flex;flex-direction:column;gap:22px}
  .hr{flex:0 1 400px;display:flex;flex-direction:column;gap:18px}
  .anchors{display:flex;flex-wrap:wrap;gap:8px}
  .anchors a{border:1.5px solid var(--deep);color:var(--deep);border-radius:999px;padding:10px 16px;font-weight:600;font-size:14px}
  .anchors a:hover{background:var(--deep);color:var(--deepInk)}
  .stage{background:radial-gradient(120% 120% at 20% 0%,#78B840 0%,#3D7A22 50%,#1F3A14 100%);border-radius:48px;padding:56px 56px 0;overflow:hidden}
  .browser{max-width:1040px;margin:0 auto;background:#fff;border-radius:20px 20px 0 0;overflow:hidden;box-shadow:0 -20px 60px -20px rgba(0,0,0,.4)}
  .chrome{height:36px;background:#F6FAF1;display:flex;align-items:center;gap:6px;padding:0 16px}
  .chrome i{width:10px;height:10px;border-radius:50%;background:#D3E6C1}
  .chrome span{margin-left:16px;font-size:12px;color:#5A6B55}
  .browser img{display:block;width:100%;height:auto}
  .two{padding-top:64px;padding-bottom:64px;display:flex;flex-wrap:wrap;gap:56px;align-items:center}
  .lca{padding-bottom:120px}
  .col{flex:1 1 420px;display:flex;flex-direction:column;gap:20px}
  .num{font-family:var(--font-display);font-size:15px;font-weight:600;color:var(--moss)}
  .tiles{flex:1 1 440px;display:grid;grid-template-columns:1fr 1fr;gap:16px}
  .tile{border-radius:32px;padding:24px;display:flex;flex-direction:column;gap:8px}
  .tile.big{grid-column:span 2;background:var(--surface);border:1px solid var(--line);padding:28px;gap:6px}
  .tile.dark{background:var(--deep);color:var(--deepInk)}
  .tile.sage{background:var(--sage)}
  .tt{font-family:var(--font-display);font-size:22px;font-weight:600;line-height:1.2}
  .bigv{font-family:var(--font-display);font-size:56px;font-weight:600;letter-spacing:-.03em;color:var(--deep)}
  .bigu{font-size:18px;font-weight:500;color:var(--ink2)}
  .split{display:flex;height:14px;border-radius:999px;overflow:hidden;gap:3px;margin-top:8px}
  .splitl{display:flex;gap:18px;flex-wrap:wrap;font-size:13px;color:var(--ink2);margin-top:4px}
  .esg-wrap{padding-top:64px;padding-bottom:64px}
  .esg{background:var(--surface);border:1px solid var(--line);border-radius:48px;padding:56px;display:flex;flex-wrap:wrap-reverse;gap:56px;align-items:center}
  .eshot{flex:1.2 1 460px;border-radius:24px;overflow:hidden;box-shadow:0 30px 60px -36px rgba(31,58,20,.45);border:1px solid var(--line)}
  .eshot img{display:block;width:100%;height:auto}
  .fw{display:flex;flex-wrap:wrap;gap:8px}
  .fw span{background:var(--bg);border:1px solid var(--line);border-radius:999px;padding:6px 12px;font-size:13px;font-weight:600;color:var(--deep)}
  .lcacard{flex:1 1 460px;background:var(--surface);border:1px solid var(--line);border-radius:40px;padding:32px;display:flex;flex-direction:column;gap:20px}
  .lh{display:flex;justify-content:space-between;align-items:baseline;gap:12px;flex-wrap:wrap}
  .stg{display:flex;gap:6px;flex-wrap:wrap}
  .stg button{border:1px solid var(--line);border-radius:999px;padding:8px 14px;background:transparent;color:var(--ink);font:600 14px var(--font-body);cursor:pointer}
  .stg button[aria-pressed='true']{background:var(--deep);color:var(--deepInk)}
  .rows{display:flex;flex-direction:column;gap:12px}
  .lr{display:flex;align-items:center;gap:12px;transition:opacity .25s}
  .ll{width:110px;flex:none;font-size:14px;color:var(--ink2)}
  .lbar{flex:1;height:22px;border-radius:999px;background:var(--bg)}
  .lbar div{height:100%;border-radius:999px}
  .lv{width:56px;text-align:right;font-family:var(--font-display);font-weight:600;color:var(--deep)}
  .note{background:var(--deep);color:var(--deepInk);border-radius:24px;padding:20px 24px;display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap}
  .tot{font-family:var(--font-display);font-size:32px;font-weight:600}
  .totu{font-size:14px;font-weight:500;color:var(--deepInk2)}
  .ai{background:var(--night);color:var(--nightInk);padding:120px 0;position:relative;overflow:hidden}
  .glow{position:absolute;left:-200px;bottom:-240px;width:640px;height:640px;border-radius:50%;background:radial-gradient(circle,rgba(120,184,64,.18),transparent 65%)}
  .ai-in{display:flex;flex-direction:column;gap:56px;position:relative}
  .aih{display:flex;flex-wrap:wrap;gap:24px;justify-content:space-between;align-items:end}
  .sim{flex:1.6 1 520px;background:rgba(166,217,122,.04);border:1px solid var(--nightLine);border-radius:36px;padding:32px;display:flex;flex-direction:column;gap:24px}
  .simtop{display:flex;justify-content:space-between;flex-wrap:wrap;gap:16px;align-items:center}
  .rate{display:flex;flex-direction:column;gap:8px;flex:1 1 260px}
  .rate span{font-size:14px;color:var(--nightInk2)}
  .rate strong{color:var(--nightInk)}
  .rate input{width:100%;accent-color:#A6D97A}
  .status{border-radius:999px;padding:10px 16px;font-weight:600;font-size:14px}
  .status.on{background:#A6D97A;color:#0E2414}
  .status.off{background:rgba(255,138,61,.16);color:#FF8A3D}
  .chart{position:relative;height:240px;display:flex;align-items:flex-end;gap:10px;border-bottom:1px solid var(--nightLine)}
  .target{position:absolute;left:0;right:0;border-top:1.5px dashed #FF8A3D}
  .target span{position:absolute;right:0;top:-24px;font-size:12px;color:#FF8A3D;font-weight:600}
  .pcol{flex:1;display:flex;flex-direction:column;align-items:center;gap:6px;height:100%;justify-content:flex-end}
  .pv{font-size:12px;color:var(--nightInk2)}
  .pbar{width:100%;border-radius:12px 12px 4px 4px;transition:height .35s}
  .years{display:flex;gap:10px;font-size:12px;color:var(--nightInk2)}
  .years span{flex:1;text-align:center}
  .aif{flex:1 1 300px;display:flex;flex-direction:column;gap:1px;background:var(--nightLine);border:1px solid var(--nightLine);border-radius:36px;overflow:hidden}
  .af{background:var(--night);padding:22px 26px;display:flex;flex-direction:column;gap:6px;flex:1}
  .aft{font-family:var(--font-display);font-size:19px;font-weight:600}
  .afd{font-size:14px;line-height:21px;color:var(--nightInk2)}
  .ingest{padding-top:120px;padding-bottom:80px;display:flex;flex-direction:column;align-items:center;text-align:center;gap:28px}
  .srcs{display:flex;flex-wrap:wrap;justify-content:center;gap:10px;max-width:820px}
  .srcs span{background:var(--surface);border:1px solid var(--line);border-radius:999px;padding:12px 20px;font-weight:600;font-size:15px;color:var(--deep)}
  .cta-wrap{padding:40px var(--gutter) 120px}
  .cta{max-width:var(--maxw);margin:0 auto;background:var(--sage);border-radius:48px;padding:64px;display:flex;flex-wrap:wrap;gap:32px;justify-content:space-between;align-items:center}
  @media (max-width:900px){
    .stage{padding:28px 20px 0;border-radius:32px}
    .esg,.cta{padding:32px;border-radius:36px}
    .lcacard,.sim{padding:24px}
    .bigv{font-size:44px}
    .tiles{grid-template-columns:1fr}
    .tile.big{grid-column:auto}
  }
  @media (max-width:560px){ .ll{width:84px;font-size:13px} .pv{font-size:10px} .chart,.years{gap:4px} }
</style>

<script>
  // LCA stage selector
  document.querySelectorAll<HTMLElement>('[data-lca]').forEach((root) => {
    const notes: string[] = JSON.parse(root.querySelector('[data-json]')!.textContent!);
    const btns = [...root.querySelectorAll<HTMLButtonElement>('.stg button')];
    const rows = [...root.querySelectorAll<HTMLElement>('[data-row]')];
    btns.forEach((b, i) => b.addEventListener('click', () => {
      btns.forEach((x, j) => x.setAttribute('aria-pressed', String(i === j)));
      rows.forEach((r, j) => (r.style.opacity = i === j ? '1' : '.45'));
      root.querySelector('[data-note]')!.textContent = notes[i];
    }));
  });
  // SBTi simulator: value = base × (1 − rate)^n; target line at 58% of baseline.
  document.querySelectorAll<HTMLElement>('[data-sim]').forEach((root) => {
    const base = +root.dataset.base!, target = +root.dataset.target!;
    const input = root.querySelector<HTMLInputElement>('input[type=range]')!;
    const bars = [...root.querySelectorAll<HTMLElement>('[data-bar]')];
    const vals = [...root.querySelectorAll<HTMLElement>('[data-v]')];
    const run = () => {
      const rate = +input.value;
      root.querySelector('[data-rate-out]')!.textContent = rate + '%';
      let end = base;
      bars.forEach((b, i) => {
        const v = base * Math.pow(1 - rate / 100, i);
        end = v;
        b.style.height = ((v / base) * 82).toFixed(1) + '%';
        vals[i].textContent = v.toFixed(0);
      });
      const st = root.querySelector<HTMLElement>('[data-status]')!;
      const on = end <= base * target;
      st.className = 'status ' + (on ? 'on' : 'off');
      st.textContent = on ? 'On track for SBTi 2030' : `Off track · ${(end - base * target).toFixed(0)} t above target`;
    };
    input.addEventListener('input', run);
  });
</script>
