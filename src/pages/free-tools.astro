---
import Layout from '../layouts/Layout.astro';
import { calcFields, fullDefaults, factors } from '../config/calculator';
import { esgQuestions } from '../config/esg';
---
<Layout title="Free tools | ZERO" description="A free carbon calculator and ESG readiness assessment. No sign-up." active="Free tools">
  <section class="container hero">
    <div style="flex:1 1 560px;display:flex;flex-direction:column;gap:20px">
      <span class="tag">Free tools · no sign-up</span>
      <h1 class="h-display" style="font-size:clamp(44px,5vw,72px)">Curious about your footprint? Start <span style="color:var(--terra)">here.</span></h1>
    </div>
    <div style="display:flex;gap:8px;flex-wrap:wrap"><a href="#calculator" class="chipbtn">Carbon calculator</a><a href="#esg" class="chipbtn">ESG assessment</a></div>
  </section>

  <section id="calculator" class="container sec" style="padding-bottom:96px">
    <div class="calc" data-calc>
      <div class="cl">
        <div style="display:flex;flex-direction:column;gap:10px"><span class="eyebrow">Free carbon calculator</span><h2 class="h-lg" style="font-size:clamp(30px,3.2vw,42px);line-height:1.05">A quick estimate of your business emissions.</h2><p style="font-size:16px;line-height:25px;color:var(--ink2)">Enter monthly figures. Results update as you type.</p></div>
        <div class="fields">
          {calcFields.map((f) => (
            <label>
              <span class="fl"><span>{f.label}</span><span class={`sc ${f.scope}`}>{f.scope}</span></span>
              <span class="fin"><input type="number" min="0" inputmode="decimal" name={f.key} value={fullDefaults[f.key]} /><span class="fu">{f.unit}</span></span>
            </label>
          ))}
        </div>
        <!-- [confirm factors]: illustrative, see src/config/calculator.ts -->
        <span class="fn">Indicative factors for illustration: grid electricity {factors.gridKgPerKwh} kgCO₂e/kWh, diesel {factors.dieselKgPerL} kg/L, petrol {factors.petrolKgPerL} kg/L, LPG {factors.lpgKgPerKg} kg/kg, {factors.tPerFlight} t per return flight, {factors.tPerEmployeeCommuteYr} t per employee commuting per year. [confirm factors]</span>
      </div>
      <div class="cr on-dark" aria-live="polite">
        <span style="color:var(--nightInk2)">Your estimated footprint</span>
        <span class="tot"><span data-out="total">0</span> <span class="totu">tCO₂e / yr</span></span>
        <div class="bar"><div data-bar="1" style="background:#5E9A3A"></div><div data-bar="2" style="background:#78B840"></div><div data-bar="3" style="background:#D9763A"></div></div>
        <div class="rows">
          <span class="row"><span class="rl"><i style="background:#5E9A3A"></i>Scope 1 · fuels</span><strong><span data-out="s1">0</span> t</strong></span>
          <span class="row"><span class="rl"><i style="background:#78B840"></i>Scope 2 · electricity</span><strong><span data-out="s2">0</span> t</strong></span>
          <span class="row last"><span class="rl"><i style="background:#D9763A"></i>Scope 3 · travel &amp; commute</span><strong><span data-out="s3">0</span> t</strong></span>
        </div>
        <div class="tip" data-out="tip"></div>
        <a href="/contact" class="btn btn-primary" style="margin-top:auto;height:52px">Get a full, audit-ready footprint</a>
      </div>
    </div>
  </section>

  <section id="esg" class="container sec" style="padding-bottom:120px">
    <div class="esg" data-esg>
      <div class="el">
        <span style="font-size:14px;font-weight:600;color:var(--deep)">ESG assessment</span>
        <h2 class="h-lg" style="font-size:clamp(30px,3.2vw,42px);line-height:1.05">Understand your ESG readiness in minutes.</h2>
        <p style="font-size:16px;line-height:25px;color:var(--ink)">Six questions. A readiness score and where to start.</p>
        <div class="dots" aria-hidden="true">{esgQuestions.map(() => <span data-dot></span>)}</div>
        <span style="font-size:14px;color:var(--ink2)" data-progress role="status">0 of 6 answered</span>
      </div>
      <div class="ep">
        <div data-asking style="display:flex;flex-direction:column;gap:20px;flex:1">
          <span class="qc" data-qcat></span>
          <h3 class="qt" data-qtext tabindex="-1"></h3>
          <div class="opts" data-opts></div>
          <div style="margin-top:auto"><button type="button" class="back" data-back>← Back</button></div>
        </div>
        <div data-done hidden style="display:flex;flex-direction:column;gap:20px;flex:1">
          <span class="qc">Your result</span>
          <div class="res">
            <div class="ring" data-ring><div class="ringin"><span class="rs" data-score></span><span style="font-size:12px;color:var(--ink2)">of 100</span></div></div>
            <div style="flex:1 1 200px;display:flex;flex-direction:column;gap:6px"><span class="lv" data-level></span><span style="font-size:15px;line-height:23px;color:var(--ink2)" data-leveld></span></div>
          </div>
          <div class="recs"><span style="font-weight:600;color:var(--deep)">Where to start</span><div data-recs style="display:flex;flex-direction:column;gap:8px"></div></div>
          <div style="margin-top:auto;display:flex;gap:10px;flex-wrap:wrap">
            <!-- No backend: "full report" only routes to Contact for now (open item) -->
            <a href="/contact" class="getrep">Get the full report</a>
            <button type="button" class="again" data-restart>Start again</button>
          </div>
        </div>
      </div>
      <script type="application/json" data-json set:html={JSON.stringify(esgQuestions)}></script>
    </div>
  </section>
</Layout>

<style>
  .tag{align-self:flex-start;background:var(--sage);color:var(--deep);border-radius:999px;padding:8px 16px;font-size:14px;font-weight:600}
  .hero{padding-top:72px;padding-bottom:48px;display:flex;flex-wrap:wrap;gap:32px;justify-content:space-between;align-items:end}
  .chipbtn{border:1.5px solid var(--deep);color:var(--deep);border-radius:999px;padding:12px 18px;font-weight:600}
  .chipbtn:hover{background:var(--deep);color:var(--deepInk)}
  .calc{background:var(--surface);border:1px solid var(--line);border-radius:48px;padding:48px;display:flex;flex-wrap:wrap;gap:40px}
  .cl{flex:1.2 1 460px;display:flex;flex-direction:column;gap:24px}
  .fields{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px}
  .fields label{background:var(--bg);border-radius:24px;padding:16px 20px;display:flex;flex-direction:column;gap:4px}
  .fields label:focus-within{outline:3px solid var(--moss);outline-offset:2px}
  .fl{display:flex;justify-content:space-between;font-size:13px;color:var(--ink2);font-weight:500}
  .sc{font-weight:700;color:var(--moss)}
  .sc.S1{color:#1F5C2E}
  .fin{display:flex;align-items:baseline;gap:6px}
  .fin input{border:none;background:transparent;font:600 26px var(--font-display);color:var(--deep);outline:none;width:100%;min-width:0}
  .fu{font-size:13px;color:var(--ink2);white-space:nowrap}
  .fn{font-size:13px;line-height:20px;color:var(--ink2)}
  .cr{flex:1 1 360px;background:var(--night);color:var(--nightInk);border-radius:36px;padding:32px;display:flex;flex-direction:column;gap:22px}
  .tot{font-family:var(--font-display);font-size:64px;line-height:1;font-weight:600;letter-spacing:-.03em}
  .totu{font-size:18px;font-weight:500;color:var(--nightInk2)}
  .bar{display:flex;height:16px;border-radius:999px;overflow:hidden;gap:3px;background:rgba(166,217,122,.06)}
  .bar div{transition:width .4s}
  .rows{display:flex;flex-direction:column;gap:10px;font-size:15px}
  .row{display:flex;justify-content:space-between;border-bottom:1px solid var(--nightLine);padding-bottom:10px}
  .row.last{border-bottom:none;padding-bottom:0}
  .rl{display:flex;align-items:center;gap:8px}
  .rl i{width:10px;height:10px;border-radius:50%}
  .tip{background:rgba(120,184,64,.12);border-radius:20px;padding:16px 18px;font-size:15px;line-height:23px}
  .esg{background:var(--sage);border-radius:48px;padding:48px;display:flex;flex-wrap:wrap;gap:40px}
  .el{flex:1 1 320px;display:flex;flex-direction:column;gap:18px}
  .dots{display:flex;gap:6px;margin-top:8px}
  .dots span{flex:1;height:8px;border-radius:999px;background:rgba(14,36,20,.18);transition:background .3s}
  .dots span.done{background:var(--deep)}
  .dots span.cur{background:var(--terra)}
  .ep{flex:1.4 1 460px;background:var(--surface);border-radius:36px;padding:36px;min-height:420px;display:flex;flex-direction:column;gap:20px}
  .qc{font-size:13px;font-weight:600;color:var(--moss)}
  .qt{font-size:28px;line-height:1.2;letter-spacing:-.02em;color:var(--deep)}
  .opts{display:flex;flex-direction:column;gap:10px}
  .opts :global(button){text-align:left;border:1.5px solid var(--line);border-radius:20px;padding:16px 20px;background:transparent;color:var(--ink);font:500 16px/24px var(--font-body);cursor:pointer}
  .opts :global(button:hover){border-color:var(--deep)}
  .opts :global(button[aria-pressed='true']){border-color:var(--deep);background:var(--sage)}
  .back{border:none;background:transparent;color:var(--ink2);font:600 15px var(--font-body);cursor:pointer}
  .res{display:flex;align-items:center;gap:24px;flex-wrap:wrap}
  .ring{width:140px;height:140px;border-radius:50%;display:flex;align-items:center;justify-content:center}
  .ringin{width:108px;height:108px;border-radius:50%;background:var(--surface);display:flex;flex-direction:column;align-items:center;justify-content:center}
  .rs{font-family:var(--font-display);font-size:36px;font-weight:600;color:var(--deep)}
  .lv{font-family:var(--font-display);font-size:30px;font-weight:600;color:var(--deep)}
  .recs{display:flex;flex-direction:column;gap:8px;border-top:1px solid var(--line);padding-top:16px}
  .recs :global(.rec){display:flex;gap:10px;font-size:15px;line-height:23px}
  .recs :global(.rec b){color:var(--terra);font-weight:700}
  .getrep{height:48px;padding:0 22px;border-radius:999px;background:var(--deep);color:var(--deepInk);font-weight:600;display:flex;align-items:center}
  .getrep:hover{background:var(--moss);color:var(--deepInk)}
  .again{height:48px;padding:0 22px;border-radius:999px;border:1.5px solid var(--deep);background:transparent;color:var(--deep);font:600 15px var(--font-body);cursor:pointer}
  @media (max-width:700px){ .calc,.esg{padding:24px;border-radius:32px} .ep,.cr{padding:24px} .tot{font-size:48px} }
</style>

<script>
  import { fullCalc, tipFor, fullDefaults, type FullInputs } from '../config/calculator';
  import { esgQuestions, scoreOf, level, weakest } from '../config/esg';

  // Carbon calculator
  document.querySelectorAll<HTMLElement>('[data-calc]').forEach((root) => {
    const read = (): FullInputs => {
      const v = { ...fullDefaults } as Record<string, number>;
      root.querySelectorAll<HTMLInputElement>('input[name]').forEach((i) => (v[i.name] = Math.max(0, +i.value || 0)));
      return v as unknown as FullInputs;
    };
    const out = (k: string, text: string) => root.querySelectorAll(`[data-out=${k}]`).forEach((e) => (e.textContent = text));
    const run = () => {
      const r = fullCalc(read());
      out('total', r.total.toFixed(1)); out('s1', r.s1.toFixed(1)); out('s2', r.s2.toFixed(1)); out('s3', r.s3.toFixed(1));
      out('tip', tipFor(r));
      [r.s1, r.s2, r.s3].forEach((v, i) => (root.querySelector<HTMLElement>(`[data-bar="${i + 1}"]`)!.style.width = (r.total ? (v / r.total) * 100 : 0) + '%'));
    };
    root.addEventListener('input', run);
    run();
  });

  // ESG assessment: 6 single-choice questions, auto-advance, Back from Q2, result screen.
  document.querySelectorAll<HTMLElement>('[data-esg]').forEach((root) => {
    const n = esgQuestions.length;
    let step = 0;
    let answers: number[] = [];
    const $ = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const dots = [...root.querySelectorAll<HTMLElement>('[data-dot]')];
    const asking = $('[data-asking]'), done = $('[data-done]');

    const render = (focus = false) => {
      const finished = step >= n;
      asking.hidden = finished; done.hidden = !finished;
      dots.forEach((d, i) => { d.className = i < step ? 'done' : i === step && !finished ? 'cur' : ''; });
      $('[data-progress]').textContent = finished ? 'Complete' : `${step} of ${n} answered`;
      if (finished) {
        const score = scoreOf(answers);
        const [lv, lvd] = level(score);
        $('[data-score]').textContent = String(score);
        $('[data-level]').textContent = lv;
        $('[data-leveld]').textContent = lvd;
        $('[data-ring]').style.background = `conic-gradient(var(--moss) ${score}%, var(--line) 0)`;
        const recs = $('[data-recs]'); recs.innerHTML = '';
        weakest(answers).forEach((r) => {
          const el = document.createElement('span'); el.className = 'rec';
          el.innerHTML = '<b>→</b><span></span>'; el.querySelector('span')!.textContent = r; recs.appendChild(el);
        });
        return;
      }
      const q = esgQuestions[step];
      $('[data-qcat]').textContent = `Question ${step + 1} of ${n} · ${q.c}`;
      $('[data-qtext]').textContent = q.q;
      $<HTMLButtonElement>('[data-back]').style.visibility = step > 0 ? 'visible' : 'hidden';
      const opts = $('[data-opts]'); opts.innerHTML = '';
      q.o.forEach((t, i) => {
        const b = document.createElement('button'); b.type = 'button'; b.textContent = t;
        b.setAttribute('aria-pressed', String(answers[step] === i));
        b.addEventListener('click', () => { answers = answers.slice(0, step); answers[step] = i; step++; render(true); });
        opts.appendChild(b);
      });
      if (focus) $('[data-qtext]').focus();
    };
    $('[data-back]').addEventListener('click', () => { step = Math.max(0, step - 1); render(true); });
    $('[data-restart]').addEventListener('click', () => { step = 0; answers = []; render(true); });
    render();
  });
</script>
