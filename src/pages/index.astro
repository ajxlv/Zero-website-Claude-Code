<script>
  // Sky-to-soil rail: a layer is active once its top has passed 50% of the viewport.
  const layers = [...document.querySelectorAll<HTMLElement>('[data-layer]')];
  const rail = [...document.querySelectorAll<HTMLElement>('[data-rail]')];
  const update = () => {
    const mid = window.innerHeight * 0.5;
    let active = 0;
    layers.forEach((l, i) => { if (l.getBoundingClientRect().top < mid) active = i; });
    rail.forEach((r, i) => r.classList.toggle('on', i === active));
  };
  update();
  window.addEventListener('scroll', update, { passive: true });
</script>
