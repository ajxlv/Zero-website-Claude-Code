  .svc-photo img{width:100%;height:100%;object-fit:cover;display:block}
  .roadmap{position:absolute;right:0;bottom:0;width:58%;background:var(--surface);border-radius:28px;padding:22px;box-shadow:0 30px 60px -30px rgba(31,58,20,.5);display:flex;flex-direction:column;gap:12px}
  .rm{display:flex;justify-content:space-between;gap:8px}
  .svc-list{flex:1 1 400px;display:flex;flex-direction:column;gap:24px}
  .scard{background:var(--surface);border:1px solid var(--line);border-radius:28px;padding:22px 24px;display:flex;flex-direction:column;gap:8px;color:var(--ink);transition:transform .2s,border-color .2s}
  .scard:hover{transform:translateY(-3px);border-color:var(--deep);color:var(--ink)}
  .st{display:flex;justify-content:space-between;font-family:var(--font-display);font-weight:600;font-size:22px;color:var(--deep)}
  .sd{font-size:15px;line-height:23px;color:var(--ink2)}

  /* 10 Events */
  .events{background:var(--deep);color:var(--deepInk);padding:120px 0;border-radius:64px 64px 0 0}
  .ev-in{display:flex;flex-direction:column;gap:40px}
  .evh{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:end;gap:24px}
  .evlink{color:var(--deepInk);font-weight:600;border-bottom:1.5px solid var(--deepInk)}
  .evlink:hover{color:var(--leaf)}
  .evbody{display:flex;flex-wrap:wrap;gap:24px;align-items:stretch}
  .evbody figure{flex:1.5 1 480px;margin:0;position:relative;border-radius:36px;overflow:hidden;min-height:420px}
  .evbody figure img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
  figcaption{position:absolute;left:20px;bottom:20px;background:rgba(14,36,20,.92);color:#F6FAF1;border-radius:16px;padding:10px 14px;font-size:14px;display:flex;gap:14px;flex-wrap:wrap}
  .evtext{flex:1 1 340px;display:flex;flex-direction:column;gap:20px}
  .evstats{display:grid;grid-template-columns:1fr 1fr;gap:12px}
  .es{background:rgba(232,245,220,.08);border:1px solid rgba(232,245,220,.18);border-radius:24px;padding:20px;display:flex;flex-direction:column;gap:4px}
  .esv{font-family:var(--font-display);font-size:34px;font-weight:600}
  .esu{font-size:14px;font-weight:500;color:var(--deepInk2)}
  .chips2{display:flex;flex-wrap:wrap;gap:8px}
  .chips2 span{background:#F6FAF1;color:#1F3A14;border-radius:999px;padding:10px 16px;font-weight:600;font-size:14px}

  /* 11 Standards */
  .standards{background:var(--deep);padding:0 0 80px;color:var(--deepInk)}
  .sin{border-top:1px solid rgba(232,245,220,.18);padding-top:40px;display:flex;flex-wrap:wrap;gap:12px;align-items:center}
  .sh{font-family:var(--font-display);font-size:22px;font-weight:600;margin-right:16px}
  .sd2{border:1.5px solid rgba(232,245,220,.4);border-radius:999px;padding:10px 18px;font-weight:600;font-size:15px}

  /* 12 Tools */
