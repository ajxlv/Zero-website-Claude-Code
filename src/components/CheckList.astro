---
interface Props { items: string[]; size?: 'lg' | 'md' }
const { items, size = 'md' } = Astro.props;
---
<ul class:list={['cl', size]}>
  {items.map((t) => <li><span class="tick" aria-hidden="true">✓</span><span>{t}</span></li>)}
</ul>
<style>
  .cl{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;border-top:1px solid var(--line)}
  li{display:flex;gap:14px;border-bottom:1px solid var(--line)}
  .md li{padding:14px 0;font-size:16px;line-height:25px}
  .lg li{padding:16px 0;font-size:17px;line-height:26px}
  .tick{flex:none;width:26px;height:26px;border-radius:50%;background:var(--sage);color:var(--deep);display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:700}
</style>
