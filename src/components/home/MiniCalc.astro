---
import { factors } from '../../config/calculator';
---
<div class="calc" data-mini-calc
  data-grid={factors.gridKgPerKwh} data-diesel={factors.dieselKgPerL} data-flight={factors.tPerFlight}>
  <div class="inputs">
    <label><span>Electricity · kWh/month</span><input type="number" min="0" inputmode="numeric" value="25000" name="kwh" /></label>
    <label><span>Diesel · litres/month</span><input type="number" min="0" inputmode="numeric" value="1200" name="diesel" /></label>
    <label><span>Flights · trips/month</span><input type="number" min="0" inputmode="numeric" value="40" name="trips" /></label>
  </div>
  <div class="result" aria-live="polite">
    <div class="top"><span class="lab">Your estimated footprint</span><span class="big"><span data-out="total">371.6</span> <span class="unit">tCO₂e/yr</span></span></div>
    <div class="bar"><div data-bar="1" style="background:#78B840"></div><div data-bar="2" style="background:#A6D97A"></div><div data-bar="3" style="background:var(--s3)"></div></div>
    <div class="legend"><span>Scope 1 · <span data-out="s1">0</span> t</span><span>Scope 2 · <span data-out="s2">0</span> t</span><span>Scope 3 travel · <span data-out="s3">0</span> t</span></div>
  </div>
</div>
<style>
  .calc{display:flex;flex-direction:column;gap:28px}
  .inputs{display:flex;flex-wrap:wrap;gap:14px}
  label{flex:1 1 160px;background:var(--bg);border-radius:24px;padding:16px 20px;display:flex;flex-direction:column;gap:4px}
  label:focus-within{outline:3px solid var(--moss);outline-offset:2px}
  label span{font-size:13px;color:var(--ink2);font-weight:500}
  input{border:none;background:transparent;font:600 26px var(--font-display);color:var(--deep);outline:none;width:100%}
  .result{background:var(--deep);color:var(--deepInk);border-radius:32px;padding:28px;display:flex;flex-direction:column;gap:14px}
  .top{display:flex;justify-content:space-between;align-items:baseline;flex-wrap:wrap;gap:12px}
  .lab{color:var(--deepInk2)}
  .big{font-family:var(--font-display);font-size:48px;font-weight:600;letter-spacing:-.02em}
  .unit{font-size:16px;font-weight:500;color:var(--deepInk2)}
  .bar{display:flex;height:16px;border-radius:999px;overflow:hidden;gap:3px}
  .bar div{transition:width .4s}
  .legend{display:flex;gap:20px;flex-wrap:wrap;font-size:13px;color:var(--deepInk2)}
</style>
<script>
  document.querySelectorAll<HTMLElement>('[data-mini-calc]').forEach((root) => {
    const f = { grid: +root.dataset.grid!, diesel: +root.dataset.diesel!, flight: +root.dataset.flight! };
    const val = (n: string) => Math.max(0, +(root.querySelector<HTMLInputElement>(`input[name=${n}]`)!.value) || 0);
    const set = (k: string, v: string) => root.querySelectorAll(`[data-out=${k}]`).forEach((e) => (e.textContent = v));
    const run = () => {
      const s1 = (val('diesel') * 12 * f.diesel) / 1000;
      const s2 = (val('kwh') * 12 * f.grid) / 1000;
      const s3 = val('trips') * 12 * f.flight;
      const t = s1 + s2 + s3;
      set('total', t.toFixed(1)); set('s1', s1.toFixed(1)); set('s2', s2.toFixed(1)); set('s3', s3.toFixed(1));
      [s1, s2, s3].forEach((v, i) => {
        root.querySelector<HTMLElement>(`[data-bar="${i + 1}"]`)!.style.width = (t ? (v / t) * 100 : 0).toFixed(1) + '%';
      });
    };
    root.addEventListener('input', run);
    run();
  });
</script>
