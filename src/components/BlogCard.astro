---
interface Props { href: string; category: string; readTime: string; title: string; cover?: string }
const { href, category, readTime, title, cover } = Astro.props;
---
<a class="bcard" href={href}>
  <div class="cover">
    {cover ? <img src={cover} alt="" loading="lazy" /> : <span class="ph" aria-hidden="true">Article cover</span>}
  </div>
  <div class="meta">
    <span class="tags"><span class="pill pill-sage" style="padding:4px 10px">{category}</span><span class="rt">{readTime} read</span></span>
    <span class="title">{title}</span>
  </div>
</a>
<style>
  .bcard{background:var(--surface);border:1px solid var(--line);border-radius:36px;padding:12px;display:flex;flex-direction:column;color:var(--ink);transition:transform .2s}
  .bcard:hover{transform:translateY(-4px);color:var(--ink)}
  .cover{aspect-ratio:4/3;position:relative;border-radius:26px;overflow:hidden;background:repeating-linear-gradient(135deg,var(--sage),var(--sage) 14px,var(--sky) 14px,var(--sky) 28px)}
  .cover img{width:100%;height:100%;object-fit:cover;display:block}
  .ph{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-size:13px;color:var(--ink2)}
  .meta{padding:18px 12px 12px;display:flex;flex-direction:column;gap:10px}
  .tags{display:flex;gap:8px;font-size:13px}
  .rt{color:var(--ink2);padding:4px 0}
  .title{font-family:var(--font-display);font-size:22px;line-height:1.2;font-weight:600;color:var(--deep)}
</style>
